---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import ChangedMyMind from '../components/ChangedMyMind.astro';
import Contact from '../components/Contact.astro';
import Header from '../components/Header.astro';
import Intro from '../components/Intro.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Separator from '../components/Separator.astro';
import Sidebar from '../components/Sidebar.astro';
import Stack from '../components/Stack.astro';
import StateIcon from '../components/StateIcon.astro';
import Timeline from '../components/Timeline.astro';

import { counts } from '../data/beliefs';
import { projects } from '../data/projects';
import { ids, labelFor, separatorFor } from '../data/sections';
import { site } from '../data/site';
---

<Base title={site.seo.title} description={site.seo.description}>
  <a class="skip" href={`#${ids.intro}`}>Skip to content</a>

  <Header />

  <div class="shell">
    <Sidebar />

    <main id="main">
      <Separator title={separatorFor(ids.intro)} first />
      <Intro />

      <Separator title={separatorFor(projects[0].id)} />
      {projects.map((project) => <ProjectCard project={project} />)}

      <Separator title={separatorFor(ids.experience)} />
      <Card id={ids.experience} title={labelFor(ids.experience)} compactHeader>
        <Timeline />
      </Card>

      <Separator title={separatorFor(ids.skills)} />
      <Card id={ids.skills} title={labelFor(ids.skills)} meta="an opinion on each" metaTone="muted">
        <Stack />
      </Card>

      <Separator title={separatorFor(ids.beliefs)} />
      <Card id={ids.beliefs}>
        <Fragment slot="header">
          <h3>Things I used to believe <span class="aside">· and what changed them</span></h3>
        </Fragment>
        <Fragment slot="header-meta">
          <p class="counts">
            <span class="count"><StateIcon status="merged" size={14} />{counts.merged} merged</span>
            <span class="count dim"><StateIcon status="open" size={14} />{counts.open} open</span>
          </p>
        </Fragment>
        <ChangedMyMind />
      </Card>

      <Separator title={separatorFor(ids.contact)} />
      <Contact />
    </main>
  </div>
</Base>

<script>
  import '../scripts/enhance';
</script>

<style>
  .shell {
    position: relative;
    display: flex;
    align-items: flex-start;
    max-width: var(--shell-max);
    margin: 0 auto;
    /*
     * 120px once the shell reaches its cap, easing down to 20px as the window
     * narrows — the gutter gives way before the content does. The divisor sets
     * the rate: (100vw - 360px) / 10 hits 120 at the ~1568px cap and bottoms
     * out at 20 below ~560px.
     */
    padding: 0 clamp(16px, calc((100vw - 360px) / 10), 120px);
  }

  /* The sidebar stops being a rail and stacks above the content. Its own
     left edge is the shell's, so main gives up the gap it owns. */
  @media (max-width: 859px) {
    .shell {
      flex-direction: column;
      align-items: stretch;
    }

    /* Both sides, not just the left — the gap main owns is the one to the
       sidebar, and there is no sidebar beside it down here. */
    main {
      padding-inline: 0;
    }
  }

  /*
   * Anchors target the <section>, but every section is introduced by the
   * separator above it — landing on the card scrolled that title out of
   * view. Offsetting by the separator plus the gap below it means clicking
   * a nav item arrives at the heading, which is what it names.
   */
  main > :global(section) {
    scroll-margin-top: calc(var(--size-section-title) * 1.3 + var(--gap-title));
  }

  main {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap-title);
    padding: clamp(18px, 3vw, 38px) var(--main-pad-x) 100px;
  }

  h3 {
    font-size: var(--size-ui);
    font-weight: 400;
    color: var(--text-title);
  }

  .aside {
    color: var(--text-quiet);
  }

  .counts {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: var(--size-label);
  }

  .count {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-title);
  }

  .count.dim {
    color: var(--text-quiet);
  }

  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 200;
  }

  .skip:focus {
    left: 8px;
    top: 8px;
    padding: 10px 14px;
    border-radius: var(--r-button);
    background: var(--action);
    color: #fff;
    font-size: var(--size-meta);
  }
</style>
