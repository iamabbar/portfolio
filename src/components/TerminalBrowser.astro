---
import { getImage } from 'astro:assets';

import avatar from '../assets/avatar-green.jpeg';
import { beliefs } from '../data/beliefs';
import { timeline, yearLabel } from '../data/career';
import { projects } from '../data/projects';
import { scenes as SCENES } from '../data/scenes';
import { intro, site } from '../data/site';
import { stack } from '../data/stack';

import '../styles/terminal-browser/base.css';
import '../styles/terminal-browser/terminal.css';
import '../styles/terminal-browser/browser.css';
import '../styles/terminal-browser/page.css';
import '../styles/terminal-browser/projects.css';
import '../styles/terminal-browser/experience.css';
import '../styles/terminal-browser/stack.css';
import '../styles/terminal-browser/changelog.css';
import '../styles/terminal-browser/contact.css';
import '../styles/terminal-browser/responsive.css';

const [firstName, ...rest] = site.name.split(' ');
const lastName = rest.join(' ');
const city = site.location.split(',')[0];
const availability = site.availability.charAt(0).toUpperCase() + site.availability.slice(1);

const avatarImage = await getImage({ src: avatar, width: 500, height: 500 });

const PROFILE = {
  firstName,
  lastName,
  role: site.role,
  tagline: 'Building products that turn complex problems into simple,',
  taglineHighlight: 'AI-powered experiences.',
  locationLine: `${city} · ${site.timezone} · ${availability}`,
  statusLine: `● ${availability} · ${site.workMode}, ${site.timezone}`,
  email: site.email,
  github: site.links.github,
  linkedin: site.links.linkedin,
  avatar: avatarImage.src,
};

const ABOUT = {
  heading: intro.heading,
  lead: intro.paragraphs[0],
  body: intro.paragraphs[1],
  note: intro.note.body,
};

const projectImages = await Promise.all(
  projects.map((project) => (project.image ? getImage({ src: project.image, width: 1200 }) : null)),
);

const PROJECTS = projects.map((project, i) => ({
  name: project.name,
  meta: `${project.company} · ${project.year}`,
  image: projectImages[i]?.src ?? '',
  imageAlt: project.imageAlt ?? `${project.name} screenshot`,
  headline: project.headline,
  hook: project.hook,
  previewUrl: project.previewUrl,
  theme: project.theme,
  liveUrl: project.liveUrl ?? '',
  sourceUrl: project.sourceUrl ?? '',
  summary: project.summary,
  tech: (project.tools ?? []).join(' · '),
}));

const EXPERIENCE = [...timeline].reverse().map((entry) => ({
  when: yearLabel(entry),
  org: entry.company ?? '',
  role: entry.title,
  current: entry.to === 'now',
}));

const STACK = stack.map((item) => [item.name, item.opinion]);

const CHANGED_MY_MIND = beliefs.map((belief) => [belief.before, belief.after]);
---

<div class="tb">
  <div id="tb-stage" class="tb-stage">
    <section id="tb-term" class="tb-term" aria-label="Terminal">
      <div class="tb-term__bar">
        <div class="tb-lights" aria-hidden="true">
          <span class="l-red"></span><span class="l-yellow"></span><span class="l-green"></span>
        </div>
        <span class="tb-term__title">zsh — abbar</span>
        <span class="tb-term__spacer"></span>
      </div>
      <div class="tb-term__body" aria-live="polite">
        <div id="tb-log" style="display: contents"></div>
        <div>
          <span class="tb-term__arrow">➜</span> <span class="tb-term__dir">~</span>
          <span id="tb-typed"></span><span class="tb-cursor" aria-hidden="true"></span>
        </div>
      </div>
    </section>

    <div class="tb-browser-wrap">
      <section class="tb-browser" aria-label="Browser">
        <div class="tb-browser__tabbar">
          <div class="tb-lights tb-browser__lights" aria-hidden="true">
            <span class="l-red"></span><span class="l-yellow"></span><span class="l-green"></span>
          </div>
          <div id="tb-tabs" class="tb-browser__tabs" role="tablist" aria-label="Pages"></div>
        </div>
        <div class="tb-browser__urlbar">
          <span class="tb-browser__nav" aria-hidden="true">‹ ›</span>
          <div id="tb-url" class="tb-browser__url">https://</div>
        </div>
        <div id="tb-page" class="tb-page"></div>
        <div id="tb-stepper" class="tb-stepper">
          <button id="tb-prev" class="tb-stepper__btn" type="button" aria-label="Previous tab">
            <span aria-hidden="true">←</span> <span id="tb-prev-label"></span>
          </button>
          <span id="tb-stepper-divider" class="tb-stepper__divider" aria-hidden="true"></span>
          <button id="tb-next" class="tb-stepper__btn" type="button" aria-label="Next tab">
            <span id="tb-next-label"></span> <span aria-hidden="true">→</span>
          </button>
        </div>
      </section>
    </div>
  </div>
</div>


<script define:vars={{ PROFILE, ABOUT, PROJECTS, EXPERIENCE, STACK, CHANGED_MY_MIND, SCENES }}>
  window.__TB_DATA__ = { PROFILE, ABOUT, PROJECTS, EXPERIENCE, STACK, CHANGED_MY_MIND, SCENES };
</script>
<script>
  import { initTerminalBrowser } from '../scripts/terminal-browser';
  initTerminalBrowser(window.__TB_DATA__);
</script>

