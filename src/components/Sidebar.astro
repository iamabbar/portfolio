---
import { Image } from 'astro:assets';

import avatar from '../assets/avatar-green.jpeg';
import { groups } from '../data/sections';
import { intro, reviewer } from '../data/site';
---

<aside aria-label="Contents">
  <div class="portrait">
    <Image
      src={avatar}
      alt={intro.avatarAlt}
      widths={[250, 500]}
      sizes="250px"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="heading">CONTENT</div>

  <nav>
    {
      groups.map((group) => (
        <>
          {(group.links.length > 1 || group.links.some((l) => l.index)) && (
            <div class="group">{group.title}</div>
          )}
          {group.links.map((link) => (
            <a
              class:list={['item', { nested: Boolean(link.index) }]}
              href={`#${link.id}`}
              data-nav={link.id}
            >
              {link.index && <span class="index">{link.index}</span>}
              {link.label}
            </a>
          ))}
        </>
      ))
    }
  </nav>

  <div class="reviewer">
    <div class="reviewer-label">{reviewer.label}</div>
    {reviewer.lines.map((line) => <div>{line}</div>)}
  </div>
</aside>

<style>
  aside {
    /* One value for the avatar and the nav, so their edges cannot drift. */
    --avatar: 250px;

    position: sticky;
    top: var(--header-h);
    flex: 0 0 var(--sidebar-w);
    align-self: flex-start;
    max-height: calc(100vh - var(--header-h));
    overflow: auto;
    padding: 20px 12px 40px clamp(10px, 2vw, 26px);
    /* No border-right: the sidebar and the content are separated by space
       alone. A rule here would only be as tall as this sticky column anyway. */
  }

  @media (max-width: 859px) {
    aside {
      display: none;
    }
  }

  /* The 12px left matches .item, whose text clears its own 2px active-state
     border on top of 10px of padding. Everything in this column starts there. */
  .portrait {
    width: var(--avatar);
    height: var(--avatar);
    margin-bottom: 24px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 50%;
  }

  nav {
    max-width: var(--avatar);
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .heading {
    padding: 0 12px 10px;
    font-size: var(--size-label);
    letter-spacing: 0.16em;
    color: var(--text-quiet);
  }

  .group {
    padding: 14px 12px 4px;
    font-size: var(--size-label);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-quiet);
  }

  .item {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 9px 10px;
    border-left: 2px solid transparent;
    border-radius: var(--r-button);
    font-size: var(--size-meta);
    white-space: nowrap;
    color: var(--text-quiet);
    transition:
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .item:hover {
    color: var(--text-title);
  }

  .item.nested {
    margin-left: 8px;
  }

  .index {
    font-size: var(--size-label);
    color: var(--violet-light);
  }

  /* Set by the scroll spy. */
  .item.is-active {
    color: var(--text-title);
    background: var(--border-subtle);
    border-left-color: var(--violet);
  }

  .reviewer {
    margin-top: 22px;
    padding: 12px 10px;
    border: 1px solid var(--border);
    border-radius: var(--r-thread);
    font-size: var(--size-label);
    line-height: 1.7;
    color: var(--text-quiet);
  }

  .reviewer-label {
    margin-bottom: 6px;
    color: var(--text-normal);
  }
</style>
