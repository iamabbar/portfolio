---
import { site } from '../data/site';
import { ids } from '../data/sections';
---

<header>
  <span class="wordmark">{site.wordmark}<span class="cursor">_</span></span>
  <a class="cta" href={`#${ids.contact}`}>Get in touch</a>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px clamp(24px, 3vw, 40px);
    padding: var(--pad-shell-y) var(--pad-shell-x);
    background: var(--bg-header);
    border-bottom: 1px solid var(--border-strong);
  }

  .wordmark {
    min-width: 0;
    font-size: clamp(15px, 1.5vw, 18px);
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1;
    color: var(--text-title);
  }

  .cursor {
    color: var(--violet-light);
  }

  .cta {
    margin-left: auto;
    /* Pinned so --header-h stays exact, including before the webfont loads. */
    display: inline-flex;
    align-items: center;
    height: var(--header-cta-h);
    padding: 0 14px;
    border-radius: var(--r-button);
    background: var(--action);
    color: #fff;
    font-size: var(--size-label);
    font-weight: 700;
    letter-spacing: 0.06em;
    white-space: nowrap;
    transition: background 0.2s ease;
  }

  .cta:hover {
    background: var(--action-hover);
    color: #fff;
  }
</style>
