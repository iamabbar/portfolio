---
import { Image } from 'astro:assets';

import Card from './Card.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<Card id={project.id} class="project" interactive>
  <Fragment slot="header">
    <h3><span class="index">{project.index}</span>&nbsp;&nbsp;{project.name}</h3>
  </Fragment>
  <Fragment slot="header-meta">
    <div class="project-meta">
      <span>{project.company} · {project.year}</span>
      {project.liveUrl && (
        <a href={project.liveUrl} target="_blank" rel="noopener noreferrer">
          site ↗
        </a>
      )}
      {project.sourceUrl && (
        <a href={project.sourceUrl} target="_blank" rel="noopener noreferrer">
          source ↗
        </a>
      )}
    </div>
  </Fragment>

  <div class="body">
    {/* The negative right margin clips the shot against the card edge —
        which is why Card sets overflow: hidden. */}
    {
      project.image && (
        <figure class="shot">
          <Image
            src={project.image}
            alt={project.imageAlt ?? ''}
            widths={[340, 680, 1100]}
            sizes="(max-width: 719px) 92vw, 340px"
            /* UI screenshots hold small type — the default quality smears it. */
            quality={92}
            loading="lazy"
            decoding="async"
          />
        </figure>
      )
    }

    {project.summary.map((paragraph) => <p class="copy" data-line>{paragraph}</p>)}

    {
      project.tools && project.tools.length > 0 && (
        <ul class="tools">
          {project.tools.map((tool) => (
            <li class="tag">{tool}</li>
          ))}
        </ul>
      )
    }
  </div>
</Card>

<style>
  h3 {
    font-size: var(--size-ui);
    font-weight: 400;
    color: var(--text-title);
  }

  .index {
    font-size: var(--size-label);
    letter-spacing: 0.18em;
    color: var(--violet-light);
  }

  .project-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: var(--size-label);
    color: var(--text-quiet);
  }

  /* Even on all four sides. The bottom used to be short because the thread
     block sat below and carried its own margin; nothing follows now. */
  .body {
    padding: var(--pad-card);
    overflow: hidden;
  }

  .shot {
    position: relative;
    z-index: 2;
    float: right;
    width: clamp(180px, 30%, 340px);
    aspect-ratio: 16 / 11;
    margin: 0 calc(-1 * clamp(36px, 7%, 80px)) 18px 26px;
    overflow: hidden;
    background: var(--surface-raised);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-image);
    transform: rotate(2.5deg);
    box-shadow: var(--shadow-image);
    transition:
      transform 0.4s var(--ease),
      box-shadow 0.4s ease;
  }

  .shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .copy {
    margin: 0 0 12px;
    max-width: var(--measure);
    font-weight: 400;
    font-size: var(--size-prose);
    line-height: 1.7;
    color: var(--text-normal);
  }

  .copy:last-child {
    margin-bottom: 0;
  }

  /* clear, so the row starts below the floated shot rather than tucking
     into the column beside it. */
  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    clear: both;
    margin-top: 6px;
    padding-top: 16px;
    border-top: 1px solid var(--border-subtle);
  }

  /* Quieter than the intro's pills — these are a footnote to the copy, not
     a claim of their own. */
  .tag {
    padding: 5px 10px;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-tile);
    font-size: var(--size-label);
    color: var(--text-quiet);
  }

  /* .project is the <section> in Card.astro. */
  :global(.project:hover) .shot,
  :global(.project:focus-within) .shot {
    transform: rotate(-1deg) translateX(-20px) scale(1.04);
    box-shadow: var(--shadow-image-hover);
  }

  /* Drop the float — the 180px minimum would squeeze the text column to
     about six characters per line. */
  @media (max-width: 719px) {
    .shot {
      float: none;
      width: 100%;
      margin: 0 0 20px;
      transform: rotate(1.5deg);
      box-shadow: 0 16px 34px rgb(0 0 0 / 0.45);
    }

    :global(.project:hover) .shot,
    :global(.project:focus-within) .shot {
      transform: rotate(0deg) scale(1.02);
      box-shadow: 0 16px 34px rgb(0 0 0 / 0.45);
    }
  }
</style>
