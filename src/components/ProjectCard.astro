---
import { Image } from 'astro:assets';

import Card from './Card.astro';
import Thread from './Thread.astro';
import type { Project } from '../data/projects';
import { site } from '../data/site';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<Card id={project.id} class="project" interactive>
  <Fragment slot="header">
    <h3><span class="index">{project.index}</span>&nbsp;&nbsp;{project.name}</h3>
  </Fragment>
  <Fragment slot="header-meta">
    <div class="project-meta">
      <span>{project.company} · {project.year}</span>
      {project.sourceUrl && <a href={project.sourceUrl}>source ↗</a>}
    </div>
  </Fragment>

  <div class="body">
    {/* The negative right margin clips the shot against the card edge —
        which is why Card sets overflow: hidden. */}
    <figure class="shot">
      <Image
        src={project.image}
        alt={project.imageAlt}
        widths={[340, 680, 1100]}
        sizes="(max-width: 719px) 92vw, 340px"
        loading="lazy"
        decoding="async"
      />
    </figure>

    {project.summary.map((paragraph) => <p class="copy" data-line>{paragraph}</p>)}

    <ul class="outcomes">
      {project.outcomes.map((outcome) => <li class="pill">{outcome}</li>)}
    </ul>
  </div>

  <Thread initials={site.initials} label="The decision" copy={project.decision}>
    {/* <details> gives the toggle its state, keyboard support and the
        "display: none when closed" the handoff asks for, with no JS. */}
    <details class="change">
      <summary>
        <span class="when-closed">+ what I'd change now</span>
        <span class="when-open">− hide what I'd change</span>
      </summary>
      <div class="panel">
        <span class="panel-label">What I'd change now:</span>{' '}
        <Fragment set:html={project.wouldChange} />
      </div>
    </details>
  </Thread>
</Card>

<style>
  h3 {
    font-size: var(--size-ui);
    font-weight: 400;
    color: var(--text-title);
  }

  .index {
    font-size: var(--size-label);
    letter-spacing: 0.18em;
    color: var(--violet-light);
  }

  .project-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: var(--size-label);
    color: var(--text-quiet);
  }

  .body {
    padding: var(--pad-card) var(--pad-card) clamp(6px, 1vw, 12px);
    overflow: hidden;
  }

  .shot {
    position: relative;
    z-index: 2;
    float: right;
    width: clamp(180px, 30%, 340px);
    aspect-ratio: 16 / 11;
    margin: 0 calc(-1 * clamp(36px, 7%, 80px)) 18px 26px;
    overflow: hidden;
    background: var(--surface-raised);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-image);
    transform: rotate(2.5deg);
    box-shadow: var(--shadow-image);
    transition:
      transform 0.4s var(--ease),
      box-shadow 0.4s ease;
  }

  .shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .copy {
    margin: 0 0 12px;
    max-width: var(--measure);
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--size-prose);
    line-height: 1.7;
    color: var(--text-normal);
  }

  .outcomes {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
    clear: both;
    margin-top: 4px;
    padding-top: 14px;
    border-top: 1px solid var(--border-subtle);
  }

  .pill {
    padding: 7px 12px;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-pill);
    font-size: var(--size-meta);
    color: var(--text-normal);
  }

  /* The card lifts from Card.astro, which owns the <section>; :global()
     reaches that element from this component's scope. */

  :global(.project:hover) .shot,
  :global(.project:focus-within) .shot {
    transform: rotate(-1deg) translateX(-20px) scale(1.04);
    box-shadow: var(--shadow-image-hover);
  }

  /* ── "What I'd change now" ──────────────────────────────────────── */

  .change summary {
    display: inline-block;
    margin-top: 12px;
    padding: 9px 14px;
    border: 1px solid rgb(240 168 104 / 0.45);
    border-radius: var(--r-pill);
    background: rgb(240 168 104 / 0.07);
    color: var(--amber);
    font-family: var(--font-mono);
    font-size: var(--size-label);
    letter-spacing: 0.04em;
    list-style: none;
    cursor: pointer;
    transition:
      background 0.25s ease,
      border-color 0.25s ease;
  }

  .change summary::-webkit-details-marker {
    display: none;
  }

  .change summary:hover {
    background: rgb(240 168 104 / 0.14);
    border-color: rgb(240 168 104 / 0.7);
  }

  .change .when-open,
  .change[open] .when-closed {
    display: none;
  }

  .change[open] .when-open {
    display: inline;
  }

  .panel {
    margin-top: 14px;
    padding: 15px 17px;
    border-left: 2px solid var(--amber);
    background: rgb(240 168 104 / 0.08);
    font-size: var(--size-meta);
    line-height: 1.75;
    color: var(--text-normal);
    animation: revealIn 0.42s var(--ease) both;
  }

  .panel-label {
    color: var(--amber);
  }

  /* Inline emphasis inside `wouldChange`. */
  .panel :global(b) {
    font-weight: inherit;
    color: var(--text-normal);
  }

  /* Drop the float — the 180px minimum would squeeze the text column to
     about six characters per line. */
  @media (max-width: 719px) {
    .shot {
      float: none;
      width: 100%;
      margin: 0 0 20px;
      transform: rotate(1.5deg);
      box-shadow: 0 16px 34px rgb(0 0 0 / 0.45);
    }

    :global(.project:hover) .shot,
    :global(.project:focus-within) .shot {
      transform: rotate(0deg) scale(1.02);
      box-shadow: 0 16px 34px rgb(0 0 0 / 0.45);
    }
  }
</style>
