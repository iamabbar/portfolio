---
interface Props {
  title: string;
  first?: boolean;
}

const { title, first = false } = Astro.props;
---

<div class:list={['separator', { first }]}>
  <h2>{title}</h2>
</div>

<style>
  /*
   * The rule goes before the title, not after it. The title now sits tight to
   * the card it introduces, so this carries the space between sections — and
   * at --border it stays quieter than the card edges below it.
   */
  .separator:not(.first)::before {
    content: '';
    display: block;
    width: 60%;
    height: 1px;
    margin: var(--gap-separator) auto;
    background: var(--border);
  }

  .separator {
    margin: 0;
  }

  h2 {
    font-size: var(--size-section-title);
    /* Explicit, so section scroll-margin can be derived from it. */
    line-height: 1.3;
    font-weight: 400;
    color: var(--text-title);
    white-space: nowrap;
  }
</style>
