---
import { Image } from 'astro:assets';

import Card from './Card.astro';
import Thread from './Thread.astro';
import avatar from '../assets/avatar-green.jpeg';
import { ids } from '../data/sections';
import { intro, site } from '../data/site';
---

<Card id={ids.intro} title={intro.cardTitle}>
  <div class="body">
    <div class="row">
      <div class="portrait">
        <Image
          src={avatar}
          alt={intro.avatarAlt}
          widths={[168, 336]}
          sizes="168px"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="copy">
        <p class="lead" data-line>{intro.lead}</p>
        {intro.paragraphs.map((paragraph) => <p data-line>{paragraph}</p>)}
        <ul class="pills">
          {intro.pills.map((pill) => <li class="pill">{pill}</li>)}
        </ul>
      </div>
    </div>
  </div>

  <Thread initials={site.initials} label={intro.note.label} copy={intro.note.body} />
</Card>

<style>
  .body {
    padding: var(--pad-card) var(--pad-card) clamp(6px, 1vw, 12px);
    overflow: hidden;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: clamp(16px, 2.6vw, 30px);
    margin-bottom: 6px;
  }

  .portrait {
    flex: 0 0 auto;
    width: clamp(104px, 13vw, 168px);
    height: clamp(104px, 13vw, 168px);
    overflow: hidden;
    background: var(--surface-raised);
    border: 1px solid var(--border-strong);
    border-radius: 14px;
    transform: rotate(-2.5deg);
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .copy {
    flex: 1 1 300px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  p {
    margin: 0 0 12px;
    max-width: var(--measure);
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--size-prose);
    line-height: 1.7;
    color: var(--text-normal);
  }

  .lead {
    margin-bottom: 14px;
    font-family: var(--font-mono);
    font-size: var(--size-ui);
    line-height: 1.4;
    color: var(--text-title);
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
    margin-top: 4px;
    padding-top: 14px;
    border-top: 1px solid var(--border-subtle);
  }

  .pill {
    padding: 7px 12px;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-pill);
    font-size: var(--size-meta);
    color: var(--text-normal);
  }
</style>
