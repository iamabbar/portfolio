---
import Card from './Card.astro';
import Note from './Note.astro';
import { ids } from '../data/sections';
import { intro } from '../data/site';
---

<Card id={ids.intro} title={intro.cardTitle}>
  <div class="body">
    <div class="row">
      <div class="copy">
        {intro.paragraphs.map((paragraph) => <p data-line>{paragraph}</p>)}
        <ul class="pills">
          {intro.pills.map((pill) => <li class="pill">{pill}</li>)}
        </ul>
      </div>
    </div>
  </div>

  <Note label={intro.note.label} copy={intro.note.body} />
</Card>

<style>
  .body {
    padding: var(--pad-card) var(--pad-card) clamp(6px, 1vw, 12px);
    overflow: hidden;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: clamp(16px, 2.6vw, 30px);
    margin-bottom: 6px;
  }

  .copy {
    flex: 1 1 300px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  p {
    margin: 0 0 12px;
    max-width: var(--measure);
    font-weight: 400;
    font-size: var(--size-prose);
    line-height: 1.7;
    color: var(--text-normal);
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
    margin-top: 4px;
    padding-top: 14px;
    border-top: 1px solid var(--border-subtle);
  }

  .pill {
    padding: 7px 12px;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-pill);
    font-size: var(--size-meta);
    color: var(--text-normal);
  }
</style>
