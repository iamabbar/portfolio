---
import StateIcon from './StateIcon.astro';
import { beliefs, statusOf } from '../data/beliefs';

const pad = (n: number) => String(n).padStart(2, '0');
---

<ul class="list">
  {
    beliefs.map((belief, i) => {
      const status = statusOf(belief);
      /*
       * Old belief first. Leading with the new one left every row opening on
       * a pronoun ("It's an agreement…") whose subject arrived a line later.
       */
      return (
        <li class="row">
          <StateIcon status={status} />
          <div class="body">
            <p class="was">
              {status === 'merged' ? (
                <s>{belief.before}</s>
              ) : (
                <span class="still">{belief.before}</span>
              )}
              <span class="num">#{pad(i + 1)}</span>
            </p>
            <p class="now">{belief.after}</p>
          </div>
        </li>
      );
    })
  }
</ul>

<style>
  .list {
    display: flex;
    flex-direction: column;
  }

  .row {
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr);
    gap: 0 12px;
    align-items: start;
    padding: 14px clamp(16px, 2.4vw, 26px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .row:last-child {
    border-bottom: 0;
  }

  /* Nudge the icon onto the first line's optical centre. */
  .row :global(.icon) {
    margin-top: 0.2em;
  }

  .body {
    min-width: 0;
  }

  .was {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 9px;
    font-family: var(--font-mono);
    font-size: var(--size-meta);
    line-height: 1.6;
  }

  /* No WAS/NOW chips: the mono/serif split already says which is which. */
  .now {
    margin-top: 8px;
    font-family: var(--font-serif);
    font-size: var(--size-ui);
    line-height: 1.5;
    color: var(--text-title);
  }

  .num {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--size-label);
    letter-spacing: 0.06em;
    color: var(--text-quiet);
    white-space: nowrap;
  }

  /* <s> keeps the semantics; the strikethrough would hurt readability here. */
  s {
    text-decoration: none;
  }

  s,
  .still {
    color: var(--text-quiet);
  }
</style>
